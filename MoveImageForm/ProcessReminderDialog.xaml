<Window x:Class="MoveImageForm.ProcessReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="进程监听" Height="180" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtMessage" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,15" FontSize="14"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="立即启动" Width="90" Height="28" Margin="5,0" IsDefault="True" Click="BtnStart_Click"/>
            <Button Content="稍后提醒" Width="90" Height="28" Margin="5,0" Click="BtnSnooze_Click"/>
            <Button Content="关闭监听" Width="90" Height="28" Margin="5,0" Click="BtnDisable_Click"/>
        </StackPanel>
    </Grid>
</Window>
