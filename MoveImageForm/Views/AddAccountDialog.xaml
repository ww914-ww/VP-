<Window x:Class="MoveImageForm.Views.AddAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加账号" Height="540" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 账号名称 -->
        <TextBlock Grid.Row="0" Text="名称（显示名称）:" Margin="0,0,0,5"/>
        <TextBox x:Name="txtName" Grid.Row="1" Height="28" Margin="0,0,0,10"/>

        <!-- 传输方式 -->
        <TextBlock Grid.Row="2" Text="传输方式:" Margin="0,0,0,5"/>
        <StackPanel x:Name="spTransportType" Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="rbSftp" Content="SFTP" Margin="0,0,15,0" IsChecked="True"
                         Checked="TransportType_Changed"/>
            <RadioButton x:Name="rbS3" Content="S3 (MinIO/AWS)" Margin="0,0,15,0"
                         Checked="TransportType_Changed"/>
            <RadioButton x:Name="rbSmb" Content="SMB (本地/网络)"
                         Checked="TransportType_Changed"/>
        </StackPanel>

        <!-- 主机地址 -->
        <TextBlock x:Name="lblHost" Grid.Row="4" Text="服务器地址:" Margin="0,0,0,5"/>
        <TextBox x:Name="txtHost" Grid.Row="5" Height="28" Text="172.16.22.138" Margin="0,0,0,10"/>

        <!-- 端口 -->
        <TextBlock Grid.Row="6" Text="端口:" Margin="0,0,0,5"/>
        <TextBox x:Name="txtPort" Grid.Row="7" Height="28" Text="22" Margin="0,0,0,10"/>

        <!-- 用户名 -->
        <TextBlock x:Name="lblUsername" Grid.Row="8" Text="账号（SSH用户名）:" Margin="0,0,0,5"/>
        <TextBox x:Name="txtUsername" Grid.Row="9" Height="28" Margin="0,0,0,10"/>

        <!-- 密码 -->
        <TextBlock x:Name="lblPassword" Grid.Row="10" Text="密码:" Margin="0,0,0,5"/>
        <PasswordBox x:Name="txtPassword" Grid.Row="11" Height="28" Margin="0,0,0,10"/>

        <!-- 权限 (SFTP only; S3 时隐藏) -->
        <TextBlock x:Name="lblRole" Grid.Row="12" Text="权限:" Margin="0,0,0,5"/>
        <StackPanel x:Name="spRole" Grid.Row="13" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="rbUpload" Content="upload（仅追加）" Margin="0,0,15,0" IsChecked="True"/>
            <RadioButton x:Name="rbAdmin" Content="admin（全部）" Margin="0,0,15,0"/>
            <RadioButton x:Name="rbReadonly" Content="readonly（只读）"/>
        </StackPanel>

        <!-- 远程路径 -->
        <TextBlock x:Name="lblRemoteRoot" Grid.Row="14" Text="远程路径:" Margin="0,0,0,5"/>
        <TextBox x:Name="txtRemoteRoot" Grid.Row="15" Height="28" Text="/" Margin="0,0,0,10"/>

        <!-- 错误提示 -->
        <TextBlock x:Name="txtError" Grid.Row="16" Foreground="Red" FontSize="12"
                   Margin="0,0,0,0" Visibility="Collapsed"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="16" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button x:Name="btnAdd" Content="添加" Width="70" Height="28" Margin="0,0,10,0"
                    Click="BtnAdd_Click" IsDefault="True"/>
            <Button Content="取消" Width="70" Height="28"
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
